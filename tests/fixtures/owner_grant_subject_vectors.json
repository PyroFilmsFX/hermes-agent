{
  "schema": "hermes-owner-grant-subject-vectors/v1",
  "normalization": {
    "applies_to": "conductor:answer:stage-variant question_sha256 (the :::stage-question directive)",
    "body": "Every line between the opening ':::stage-question{...}' line and the closing ':::' line, exclusive of both fence lines: the question text followed by the numbered options, joined by LF.",
    "steps": [
      "Replace every CRLF (U+000D U+000A) with LF (U+000A). A lone CR is left as is.",
      "Trim only U+0020 SPACE, U+0009 TAB and U+000A LF from both ends. No other character is trimmed (not U+000D, not U+00A0, not other Unicode spaces).",
      "Apply no Unicode normalisation (no NFC/NFD/NFKC/NFKD).",
      "question_sha256 = lowercase hex SHA-256 of the UTF-8 bytes of the result."
    ],
    "vectors": [
